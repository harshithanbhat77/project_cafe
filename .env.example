# development | production (production turns off /docs and refuses to seed demo data)
ENVIRONMENT=development

# Required. Generate each with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

ACCESS_TOKEN_MINUTES=480
# How long a guest's table session lasts after they enter their name/phone
SESSION_TTL_MINUTES=180

# Where the frontend is served from (CORS) and where the browser reaches the API
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001

# Production only (docker-compose.prod.yml): the domain Caddy gets an HTTPS certificate for.
# FRONTEND_ORIGIN and NEXT_PUBLIC_API_URL above are set automatically in production.
# DOMAIN=order.yourcafe.com
